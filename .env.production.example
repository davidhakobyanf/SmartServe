# For the first deployment use: smartserve.YOUR-SERVER-IP.sslip.io
# Example for 1.2.3.4: smartserve.1-2-3-4.sslip.io
DOMAIN=smartserve.YOUR-SERVER-IP.sslip.io

POSTGRES_DB=smartserve
POSTGRES_USER=smartserve
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=1h
